# NTParts Environment Variables

NEXT_PUBLIC_APP_URL=http://localhost:3000

# NTParts Global Parts Intelligence
# Keep all provider keys server-side only. Never prefix them with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional independent second-opinion provider.
# When configured, PartMind uses it as a secondary reasoning layer; it is never treated as source evidence.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint for self-hosted/compatible providers.
# OPENAI_API_BASE=https://api.openai.com/v1

# API Configuration (future)
# NEXT_PUBLIC_API_URL=https://api.example.com
# API_SECRET_KEY=your_api_key_here

# Image Service (optional)
# VISION_API_KEY=your_vision_api_key_here
# VISION_API_ENDPOINT=https://api.vision.example.com

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# Features
NEXT_PUBLIC_ENABLE_DEMO_DATA=true
NEXT_PUBLIC_ENABLE_AD_SLOTS=true
