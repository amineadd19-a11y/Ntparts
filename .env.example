# NTParts Environment Variables

NEXT_PUBLIC_APP_URL=http://localhost:3000

# NTParts Global Parts Intelligence
# Keep this key server-side only. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Internal read-only fitment review API
# Set a random secret of at least 32 characters in Vercel Environment Variables.
# Never use NEXT_PUBLIC_ and never send the token in a URL/query string.
FITMENT_REVIEW_API_TOKEN=replace_with_a_random_secret_of_at_least_32_characters

# Features
# Ad slots only — no demo catalogue data is ever published.
NEXT_PUBLIC_ENABLE_AD_SLOTS=true
