# NTParts Environment Variables

NEXT_PUBLIC_APP_URL=http://localhost:3000

# NTParts Global Parts Intelligence
# Keep this key server-side only. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Features
# Ad slots only — no demo catalogue data is ever published.
NEXT_PUBLIC_ENABLE_AD_SLOTS=true
