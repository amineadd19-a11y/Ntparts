{
  "name": "ntparts",
  "version": "1.0.0",
  "description": "Premium AI-powered truck parts catalogue with OEM/reference search, compatibility system, and multi-language support",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "quality-gate": "npm run type-check && npm run lint && npm test -- --runInBand && npm run validate:catalog && npm run build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "next": "^14.0.0",
    "next-i18next": "^14.0.0",
    "i18next": "^23.7.0",
    "react-i18next": "^13.5.0",
    "next-seo": "^6.0.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "lucide-react": "^0.292.0",
    "zustand": "^4.4.0",
    "clsx": "^2.0.0",
    "react-hook-form": "^7.48.0",
    "zod": "^3.22.0",
    "isomorphic-dompurify": "^2.30.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/jest-dom": "^6.1.0",
    "prettier": "^3.1.0",
    "eslint": "^8.52.0",
    "eslint-config-next": "^14.0.0"
  }
}
